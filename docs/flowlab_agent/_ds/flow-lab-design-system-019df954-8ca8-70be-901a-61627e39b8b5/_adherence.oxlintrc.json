{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:onLogin|logoSrc|key|ref|className|style|children)$/]",
        "message": "<AuthScreen> doesn't accept that prop. Declared props: onLogin, logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|ghost|icon)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger' | 'ghost' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:interactive|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: interactive, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashboardStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|tint|delta|up|key|ref|className|style|children)$/]",
        "message": "<DashboardStat> doesn't accept that prop. Declared props: label, value, icon, tint, delta, up."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashboardStat'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:blue|violet|green|amber)$/]",
        "message": "<DashboardStat> tint must be one of 'blue' | 'violet' | 'green' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|children|footer|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, onClose, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|code|cat|stock|status|expiry|key|ref|className|style|children)$/]",
        "message": "<ProductRow> doesn't accept that prop. Declared props: name, code, cat, stock, status, expiry."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|low-stock|expired)$/]",
        "message": "<ProductRow> status must be one of 'active' | 'low-stock' | 'expired'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequestRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|dept|status|tone|when|who|key|ref|className|style|children)$/]",
        "message": "<RequestRow> doesn't accept that prop. Declared props: id, title, dept, status, tone, when, who."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequestRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|info|neutral)$/]",
        "message": "<RequestRow> tone must be one of 'success' | 'warning' | 'danger' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tint|icon|value|label|delta|up|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: tint, icon, value, label, delta, up."
      },
      {
        "selector": "JSXOpeningElement[name.name='Topbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|key|ref|className|style|children)$/]",
        "message": "<Topbar> doesn't accept that prop. Declared props: title, subtitle, action."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
